@model B2BWholesale.Data.Services.CatalogPage

@{
    ViewData["Title"] = "Catalogue";
    string query = ViewData["Query"] as string ?? string.Empty;
    const int LowStockLevel = 20;
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Product Catalogue</h2>
            <p class="text-muted mb-0">
                Wholesale prices are per pack. Available stock is shown live.
            </p>
        </div>

        <a asp-controller="OrderEntry"
           asp-action="Create"
           class="btn btn-success">
            New Order
        </a>
    </div>

    <form method="get" asp-action="Index" class="row g-2 mb-4">
        <div class="col-sm-8 col-md-6">
            <input type="search"
                   name="q"
                   value="@query"
                   class="form-control"
                   placeholder="Search by item name or pack size..." />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Search</button>
            @if (!string.IsNullOrEmpty(query))
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
            }
        </div>
    </form>

    @if (Model.TotalCount == 0)
    {
        <div class="alert alert-info">No items match your search.</div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Item</th>
                                <th>Pack size</th>
                                <th class="text-end">Unit price</th>
                                <th class="text-center">Stock</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="fw-semibold">@item.ItemName</td>
                                    <td>@item.Size</td>
                                    <td class="text-end">@item.Price.ToString("N0") VND</td>
                                    <td class="text-center">
                                        @if (item.StockQuantity == 0)
                                        {
                                            <span class="badge bg-danger">Out of stock</span>
                                        }
                                        else if (item.StockQuantity <= LowStockLevel)
                                        {
                                            <span class="badge bg-warning text-dark">Low: @item.StockQuantity</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">@item.StockQuantity</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (item.StockQuantity == 0)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled>Order</button>
                                        }
                                        else
                                        {
                                            <a asp-controller="OrderEntry"
                                               asp-action="Create"
                                               asp-route-itemId="@item.ItemId"
                                               class="btn btn-sm btn-outline-primary">
                                                Order
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3">
            <span class="text-muted small">
                Page @Model.Page of @Model.TotalPages (@Model.TotalCount items)
            </span>

            <nav aria-label="Catalogue pages">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-q="@query"
                           asp-route-page="@(Model.Page - 1)">Previous</a>
                    </li>
                    <li class="page-item @(Model.HasNext ? "" : "disabled")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-q="@query"
                           asp-route-page="@(Model.Page + 1)">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
