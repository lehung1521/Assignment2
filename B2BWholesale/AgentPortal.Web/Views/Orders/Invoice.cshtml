@model B2BWholesale.Data.Models.Order

@{
    ViewData["Title"] = "Invoice";

    // Tính tổng tiền dựa trên giá tại thời điểm đặt hàng
    var total = Model.OrderDetails.Sum(
        d => d.Quantity * d.UnitAmount);
}

<style>
    /* Main invoice container */
    .invoice-box {
        max-width: 850px;
        margin: 30px auto;
        padding: 30px;
        background: white;
        border-radius: 12px;
    }

    .invoice-header {
        text-align: center;
        margin-bottom: 30px;
    }

    .invoice-title {
        font-weight: 700;
        color: #2563eb;
    }

    .invoice-table th,
    .invoice-table td {
        padding: 12px;
        vertical-align: middle;
    }

    .invoice-total {
        font-size: 1.3rem;
        font-weight: 700;
        color: #1e40af;
    }

    /* Responsive mobile */
    @@media (max-width: 576px) {
        .invoice-box {
            margin: 10px auto;
            padding: 15px;
        }

        .invoice-title {
            font-size: 1.5rem;
        }

        .invoice-table {
            font-size: 0.875rem;
        }

        .invoice-total {
            font-size: 1.1rem;
        }
    }

    /* Print on A4 paper */
    @@media print {
        @@page {
            size: A4;
            margin: 15mm;
        }

        header,
        footer,
        .no-print {
            display: none !important;
        }

        html,
        body {
            background: white !important;
            color: black !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        .invoice-box {
            max-width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
            border: none !important;
            border-radius: 0 !important;
            box-shadow: none !important;
        }

        .invoice-title,
        .invoice-total {
            color: black !important;
        }

        .table-responsive {
            overflow: visible !important;
        }

        table {
            width: 100% !important;
            border-collapse: collapse;
        }

        thead {
            display: table-header-group;
        }

        tr {
            break-inside: avoid;
            page-break-inside: avoid;
        }
    }
</style>

<div class="invoice-box shadow-sm border">

    <!-- Invoice header -->
    <div class="invoice-header">
        <h2 class="invoice-title">
            B2B WHOLESALE
        </h2>

        <h4 class="fw-semibold">
            SALES INVOICE
        </h4>

        <p class="text-muted">
            Wholesale Order Management System
        </p>
    </div>

    <hr />

    <!-- Invoice information -->
    <div class="row mb-4">

        <div class="col-md-6 mb-3">
            <h5 class="fw-bold mb-3">
                Invoice Information
            </h5>

            <p>
                <strong>Invoice No:</strong>
                #@Model.OrderID
            </p>

            <p>
                <strong>Order Date:</strong>
                @Model.OrderDate.ToString("dd/MM/yyyy")
            </p>

            <p>
                <strong>Order Status:</strong>
                <span class="badge bg-secondary">
                    @Model.OrderStatus
                </span>
            </p>
        </div>

        <div class="col-md-6 mb-3">
            <h5 class="fw-bold mb-3">
                Agent Information
            </h5>

            <p>
                <strong>Agent:</strong>
                @Model.Agent?.AgentName
            </p>

            <p>
                <strong>Address:</strong>
                @Model.Agent?.Address
            </p>

            <p>
                <strong>Phone:</strong>
                @Model.Agent?.Phone
            </p>
        </div>

    </div>

    <!-- Ordered items -->
    <h5 class="fw-bold mb-3">
        Order Items
    </h5>

    <div class="table-responsive">
        <table class="table table-bordered invoice-table">
            <thead class="table-light">
                <tr>
                    <th>Item</th>
                    <th>Quantity</th>
                    <th>Unit Price</th>
                    <th>Amount</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var detail in Model.OrderDetails)
                {
                    var subtotal =
                        detail.Quantity * detail.UnitAmount;

                    <tr>
                        <td>
                            @detail.Item?.ItemName
                        </td>

                        <td>
                            @detail.Quantity
                        </td>

                        <td>
                            @detail.UnitAmount.ToString("N0") VND
                        </td>

                        <td>
                            @subtotal.ToString("N0") VND
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Total amount -->
    <div class="text-end mt-4">
        <p class="invoice-total">
            Total Amount:
            @total.ToString("N0") VND
        </p>
    </div>

    <hr class="mt-4" />

    <!-- Footer message -->
    <div class="text-center mt-4">
        <p class="fw-semibold mb-1">
            Thank you for your business!
        </p>

        <p class="text-muted small">
            B2B Wholesale Agent Portal
        </p>
    </div>

    <!-- Action buttons -->
    <div class="text-center no-print mt-4">

        <button type="button"
                onclick="window.print()"
                class="btn btn-primary px-4 me-2">
            Print Invoice
        </button>

        <a asp-controller="Orders"
           asp-action="Details"
           asp-route-id="@Model.OrderID"
           class="btn btn-outline-secondary px-4">
            Back to Order
        </a>

    </div>

</div>
