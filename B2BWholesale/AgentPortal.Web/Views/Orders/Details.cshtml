@model B2BWholesale.Data.Models.Order

@{
    ViewData["Title"] = "Order Details";

    var total = Model.OrderDetails.Sum(
        d => d.Quantity * d.UnitAmount);
}

<div class="container py-4">

    <div class="d-flex justify-content-between
        align-items-center mb-4 flex-wrap gap-2">
        <h2 class="fw-bold">
            Order #@Model.OrderID
        </h2>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Back to My Orders
        </a>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5>Order Information</h5>
            <hr />

            <p>
                <strong>Agent:</strong>
                @Model.Agent?.AgentName
            </p>
            <p>
                <strong>Order Date:</strong>
                @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")
            </p>
            <p>
                <strong>Status:</strong>
                @Model.OrderStatus
            </p>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <h5 class="mb-3">Ordered Items</h5>

            <div class="table-responsive">
                <table class="table table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Item</th>
                            <th>Size</th>
                            <th>Quantity</th>
                            <th>Unit Price</th>
                            <th>Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var detail in Model.OrderDetails)
                        {
                            var subtotal =
                                detail.Quantity * detail.UnitAmount;

                            <tr>
                                <td>@detail.Item?.ItemName</td>
                                <td>@detail.Item?.Size</td>
                                <td>@detail.Quantity</td>
                                <td>
                                    @detail.UnitAmount.ToString("N0") VND
                                </td>
                                <td>
                                    @subtotal.ToString("N0") VND
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="text-end">
                <h4 class="fw-bold">
                    Total: @total.ToString("N0") VND
                </h4>
            </div>

            <div class="text-end mt-3">
                <a asp-action="Invoice"
                   asp-route-id="@Model.OrderID"
                   class="btn btn-success">
                    Print Invoice
                </a>
            </div>

        </div>
    </div>
</div>
