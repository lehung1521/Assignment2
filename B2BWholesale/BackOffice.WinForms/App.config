<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<connectionStrings>
		<add name="DefaultConnection"
connectionString="Server=(localdb)\MSSQLLocalDB;Database=B2BWholesaleDB;Trusted_Connection=True;TrustServerCertificate=True;"			 providerName="Microsoft.Data.SqlClient" />
	</connectionStrings>
	<appSettings>
		<!-- Dashboard (Task 1.4): items with fewer units than this are shown as low stock -->
		<add key="LowStockThreshold" value="20" />
	</appSettings>
</configuration>